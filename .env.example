# ---------------------------------------
# Server Configuration
# ---------------------------------------

# Port the Express server listens on (Render injects its own PORT automatically;
# this default is used for local/Docker runs)
PORT=10000

# Node environment: development | production
NODE_ENV=production

# ---------------------------------------
# Database
# ---------------------------------------

# MongoDB connection string.
# Local Docker Compose default: mongodb://mongo:27017/quranapp
# Production (MongoDB Atlas example):
# mongodb+srv://<user>:<password>@<cluster-url>/quranapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quranapp

# ---------------------------------------
# CORS
# ---------------------------------------

# Allowed origin for cross-origin requests (your deployed frontend URL, or "*" for dev only)
CORS_ORIGIN=http://localhost:10000