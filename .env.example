# ---------------------------------------------------
# QuranApp Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ---------------------------------------------------

# Node environment: development | production | test
NODE_ENV=production

# Port the Express server listens on
# Render assigns this dynamically in production via its own PORT env var,
# but keep 10000 as local/docker-compose default.
PORT=10000

# MongoDB connection string
# Local docker-compose default:
#   mongodb://mongo:27017/quranapp
# Render managed Postgres/Mongo or Atlas:
#   mongodb+srv://<user>:<password>@<cluster-url>/quranapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quranapp

# Allowed CORS origin for the client (set to your deployed frontend URL)
CORS_ORIGIN=http://localhost:10000