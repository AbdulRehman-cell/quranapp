# ---------------------------------------------------
# QuranApp — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ---------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=production

# Port the Express server listens on
# Render injects PORT automatically in production — this is for local/docker use
PORT=10000

# MongoDB connection string
# Local Docker Compose: mongodb://mongo:27017/quranapp
# MongoDB Atlas (recommended for Render): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quranapp?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quranapp

# Allowed CORS origin(s) for the client
# Set to your deployed frontend URL, e.g. https://quranapp.onrender.com
CORS_ORIGIN=http://localhost:10000

# Deploy hook URL used by GitHub Actions to trigger Render deploys
# (Set this as a GitHub Actions secret named RENDER_DEPLOY_HOOK_URL, not here)
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxx?key=xxxxxxxx